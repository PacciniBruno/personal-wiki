<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily personal-wiki sync + wiki update (tier-1).
  Runs once per calendar day — on first wake of the day.

  SETUP: Replace the placeholders below before installing:
    YOUR_USERNAME     — your macOS username  (run: whoami)
    YOUR_NODE_PATH    — path to node binary  (run: which node)
    YOUR_PROJECT_PATH — absolute path to this repo (run: pwd in the repo)

  Install:
    cp scripts/com.YOUR_USERNAME.personal-wiki-sync.plist.template \
       ~/Library/LaunchAgents/com.YOUR_USERNAME.personal-wiki-sync.plist
    # Edit the copy and replace all YOUR_* placeholders
    launchctl load ~/Library/LaunchAgents/com.YOUR_USERNAME.personal-wiki-sync.plist

  Logs:
    ~/Library/Logs/personal-wiki-sync.log
    ~/Library/Logs/personal-wiki-sync.error.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.YOUR_USERNAME.personal-wiki-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
      STATE_DIR="${STATE_DIR:-$HOME/.personal-wiki}";
      STAMP="$STATE_DIR/last-sync-date";
      TODAY=$(date +%Y-%m-%d);
      [ -f "$STAMP" ] &amp;&amp; [ "$(cat "$STAMP")" = "$TODAY" ] &amp;&amp; exit 0;
      NODE=YOUR_NODE_PATH;
      DIR=YOUR_PROJECT_PATH;
      cd "$DIR" &amp;&amp;
      "$NODE" src/index.js --mode=sync &amp;&amp;
      "$NODE" src/synthesize.js --tier=1 &amp;&amp;
      mkdir -p "$STATE_DIR" &amp;&amp;
      echo "$TODAY" > "$STAMP"
    </string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USERNAME</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
    <!-- Optional: set CLAUDE_BIN if the claude CLI is not in your PATH -->
    <!-- <key>CLAUDE_BIN</key> <string>/path/to/claude</string> -->
  </dict>

  <!-- Fire every hour; launchd also fires on wake if interval elapsed during sleep -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Also run immediately when the agent loads at login -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/personal-wiki-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/personal-wiki-sync.error.log</string>
</dict>
</plist>
