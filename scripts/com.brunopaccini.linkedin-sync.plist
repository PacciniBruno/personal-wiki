<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily LinkedIn sync + wiki update (tier-1).
  Runs once per calendar day — on first wake of the day.

  How it works:
  - launchd fires every hour (StartInterval) and immediately on wake from sleep
    if the last run was >1 hour ago.
  - The inline guard exits immediately if already ran today (stamp in
    ~/.linkedin-notion-sync/last-sync-date).
  - On failure the stamp is NOT written, so the next wake retries automatically.

  Install:
    cp scripts/com.brunopaccini.linkedin-sync.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.brunopaccini.linkedin-sync.plist
    launchctl load ~/Library/LaunchAgents/com.brunopaccini.linkedin-sync.plist

  Logs:
    ~/Library/Logs/linkedin-sync.log
    ~/Library/Logs/linkedin-sync.error.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brunopaccini.linkedin-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
      STAMP="$HOME/.linkedin-notion-sync/last-sync-date";
      TODAY=$(date +%Y-%m-%d);
      [ -f "$STAMP" ] &amp;&amp; [ "$(cat "$STAMP")" = "$TODAY" ] &amp;&amp; exit 0;
      NODE=/Users/brunopaccini/.nvm/versions/node/v22.14.0/bin/node;
      DIR=/Users/brunopaccini/Documents/Dev/linkedin-notion-sync;
      cd "$DIR" &amp;&amp;
      "$NODE" src/index.js --mode=sync &amp;&amp;
      "$NODE" src/synthesize.js --tier=1 &amp;&amp;
      echo "$TODAY" > "$STAMP"
    </string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/brunopaccini</string>
    <key>PATH</key>
    <string>/Users/brunopaccini/.nvm/versions/node/v22.14.0/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLAUDE_BIN</key>
    <string>/Users/brunopaccini/.nvm/versions/node/v22.14.0/bin/claude</string>
  </dict>

  <!-- Fire every hour; launchd also fires on wake if interval elapsed during sleep -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Also run immediately when the agent loads at login -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/brunopaccini/Library/Logs/linkedin-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brunopaccini/Library/Logs/linkedin-sync.error.log</string>
</dict>
</plist>
