# ── Required ──────────────────────────────────────────────────────────────────
# A logged-in `claude` CLI (run `claude` → `/login` once in a terminal). Both
# categorization and synthesis run through `claude -p` on your Claude
# subscription — no API key needed.
#
# ANTHROPIC_API_KEY is optional and currently unused by the pipeline. Set it
# only if you re-introduce a direct-SDK code path.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Paths (optional — defaults shown) ─────────────────────────────────────────
# Root of the knowledge base (wiki files live here)
# KB_DIR=~/knowledge

# State & Chrome session directory
# STATE_DIR=~/.personal-wiki

# Path to the claude CLI (auto-detected via `which claude` if not set)
# CLAUDE_BIN=/usr/local/bin/claude

# ── Sources (optional) ────────────────────────────────────────────────────────
# Web clips drop folder — configure Obsidian Web Clipper to save here.
# Defaults to $KB_DIR/inbox (created automatically by init-kb).
# Legacy $KB_DIR/chrome-clipped is still scanned automatically if it exists.
# Set to 'false' to disable this source.
# WEB_CLIP_DIR=/path/to/custom/clip/folder

# Apple Notes folder to scan for saved links (disabled if not set)
# APPLE_NOTES_FOLDER=Saved Notes

# Max age of Twitter bookmarks to ingest, in days (default: 365)
# TWITTER_MAX_AGE_DAYS=365

# ── Categorization (optional) ─────────────────────────────────────────────────
# One-sentence description of yourself — helps Claude categorize content better
# USER_CONTEXT=a founder and product leader focused on AI startups

# ── Synthesis (optional) ──────────────────────────────────────────────────────
# Model used by `claude -p` for tier-1, tier-2, and projects synthesis.
# Sonnet is the default — high quality and ~5x cheaper than Opus.
# Options: haiku | sonnet | opus | full model name (e.g. claude-sonnet-4-6)
# SYNTH_MODEL=sonnet

# Per-call cost ceiling for each `claude -p` synthesis invocation.
# Caps a runaway agent at a deterministic dollar amount per call.
# SYNTH_MAX_USD=3.00
#
# Project synthesis pulls in each project's linked-theme raw/ files, so it's the
# heaviest call and gets its own (higher) ceiling.
# SYNTH_PROJECT_MAX_USD=6.00
